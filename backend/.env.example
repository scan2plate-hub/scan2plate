PORT=5000
# JSON for a Firebase service account with Firestore, Auth and Storage access.
# FIREBASE_SERVICE_ACCOUNT_JSON is also accepted for existing deployments.
FIREBASE_SERVICE_ACCOUNT=your_service_account_json_optional
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
OCR_SPACE_API_KEY=your_key_here
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Razorpay: the public key ID may be used in frontend code. The key secret and
# the webhook secret must NEVER leave the backend. Subscriptions must be
# enabled on the Razorpay account; see docs/SUBSCRIPTIONS.md.
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Must match the secret set on the Razorpay webhook pointing at
# POST /api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# AI Help Assistant and AI menu-image generation. These keys MUST stay
# server-side: the browser calls this backend, never the provider directly.
AI_PROVIDER=openai
AI_API_KEY=your_provider_api_key
AI_MODEL=gpt-4o-mini
# Optional overrides for image generation (defaults to AI_PROVIDER/AI_API_KEY).
AI_IMAGE_PROVIDER=openai
AI_IMAGE_API_KEY=
AI_IMAGE_MODEL=gpt-image-1
AI_IMAGE_BASE_URL=https://api.openai.com/v1/images/generations
