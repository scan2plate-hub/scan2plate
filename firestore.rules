rules_version = '2';

// =============================================================
//  Scan2Plate Firestore security rules
//  -------------------------------------------------------------
//  Before this file existed the database had NO rules, which means
//  every document was readable, writable and deletable by anyone
//  holding the public web API key — and that key ships in the
//  client bundle, so "anyone" means anyone.
//
//  The shape of the app constrains what these rules can do:
//
//   * Customers are NOT signed in. They scan a QR code and order.
//     So the menu, the table list, the restaurant's public profile
//     and order creation must stay open to unauthenticated callers.
//
//   * Everything a customer does not need is closed: staff records,
//     payroll, attendance, expenses, purchases, inventory, counters,
//     audit logs, subscriptions, and the owner's contact details.
//
//  Rule of thumb used throughout: a customer may READ what is
//  printed on the menu and CREATE their own order. Nothing else.
// =============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------------- identity helpers ---------------- */

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Super admins are recorded in one of two collections; both are
    // checked because the app has written to both over time.
    function isSuperAdmin() {
      return signedIn() && (
        exists(/databases/$(database)/documents/superAdmins/$(uid())) ||
        exists(/databases/$(database)/documents/super_admins/$(uid()))
      );
    }

    // Owner-level: the restaurant's own admin account, or a super admin.
    // This is the level that may change settings (the UPI ID lives there),
    // manage staff accounts, and read the owner's private details.
    function isOwnerOf(rid) {
      return signedIn() && (
        isSuperAdmin()
        || get(/databases/$(database)/documents/restaurants/$(rid)).data.adminUid == uid()
      );
    }

    // The document id of a staff record is derived from the e-mail address,
    // exactly as login.js writes it: "a.b@c.com" -> "a_b_c_com". The dot is
    // escaped because replace() takes a regex, and an unescaped '.' would
    // match every character and mangle the whole address.
    function staffDocId() {
      return request.auth.token.email.lower().replace('@', '_').replace('\\.', '_');
    }

    // A manager, cashier or kitchen account: not the restaurant's adminUid,
    // but a users/{doc} record of this restaurant whose uid is the caller's
    // and whose status has not been revoked. Without this, deploying these
    // rules would lock every non-owner staff account out of the dashboard.
    function hasStaffRecord(rid) {
      return request.auth.token.email != null
        && exists(/databases/$(database)/documents/restaurants/$(rid)/users/$(staffDocId()))
        && get(/databases/$(database)/documents/restaurants/$(rid)/users/$(staffDocId())).data.uid == uid()
        && !(get(/databases/$(database)/documents/restaurants/$(rid)/users/$(staffDocId())).data.get('status', 'active') in ['disabled', 'suspended', 'inactive', 'removed']);
    }

    // Staff-level: anyone who works at this restaurant, owner included.
    function isStaffOf(rid) {
      return isOwnerOf(rid) || hasStaffRecord(rid);
    }

    /* ---------------- restaurants ---------------- */

    match /restaurants/{rid} {
      // Public: the customer ordering site lists restaurants and reads
      // one restaurant's profile without signing in. This document must
      // therefore hold NO private data — owner contact details live in
      // the private/ subcollection below.
      allow get, list: if true;

      // Only the restaurant's own admin, or a super admin, may change it.
      allow create: if isSuperAdmin();
      allow update: if isOwnerOf(rid);
      allow delete: if isSuperAdmin();

      // -- owner contact details, billing identifiers, anything that
      //    would help someone attack or impersonate the business.
      match /private/{docId} {
        allow read, write: if isOwnerOf(rid);
      }

      // -- what the customer is allowed to see -------------------

      match /menu/{itemId} {
        allow get, list: if true;              // the menu is the product
        allow write: if isStaffOf(rid);
      }

      match /tables/{tableId} {
        allow get, list: if true;              // table QR lookup
        allow write: if isStaffOf(rid);
      }

      // settings/general carries the UPI ID used to render the payment
      // QR, the tax percentage shown on the bill, and the geofence the
      // customer's browser is checked against. A customer cannot order
      // without them, so this stays readable.
      match /settings/{docId} {
        allow get, list: if true;
        allow write: if isOwnerOf(rid);
      }

      match /table_qrs/{qrId} {
        allow get, list: if true;
        allow write: if isStaffOf(rid);
      }

      // -- staff-only, in every case -----------------------------

      match /users/{userId} {
        // A staff member may read their own record so the app can
        // resolve their role at login; the rest is owner-only.
        allow get: if signedIn();
        allow list, write: if isOwnerOf(rid);
      }

      match /staff/{docId}            { allow read, write: if isStaffOf(rid); }
      match /staff_advances/{docId}   { allow read, write: if isStaffOf(rid); }
      match /attendance/{docId}       { allow read, write: if isStaffOf(rid); }
      match /payroll/{docId}          { allow read, write: if isStaffOf(rid); }
      match /expenses/{docId}         { allow read, write: if isStaffOf(rid); }
      match /purchase_bills/{docId}   { allow read, write: if isStaffOf(rid); }
      match /inventory/{docId}        { allow read, write: if isStaffOf(rid); }
      match /inventory_items/{docId}  { allow read, write: if isStaffOf(rid); }
      match /inventory_logs/{docId}   { allow read, write: if isStaffOf(rid); }
      match /delivery_integrations/{docId} { allow read, write: if isStaffOf(rid); }

      // Daily order/bill serial counters. A customer's order allocates
      // one, so creating and incrementing stays open; deleting does not,
      // because that would let someone reset a restaurant's bill numbers.
      match /counters/{docId} {
        allow get: if true;
        allow create, update: if true;
        allow list, delete: if isStaffOf(rid);
      }

      /* ---------------- hotel PMS ----------------

         Every hotel record lives under restaurants/{rid}, so isolation by
         business is structural: there is no path by which one hotel can
         name another hotel's document. That is section 45's requirement,
         and it is why these are subcollections rather than top-level
         collections keyed by a businessId field, which would rely on every
         query remembering to filter.

         Without these rules the owner-only catch-all below would still
         apply, and a receptionist could not open the front desk. They are
         staff-level because the front desk, housekeeping and maintenance
         are staff jobs; the finer question of WHICH staff member may do
         WHAT is enforced above this, in the app's permission layer, and
         below it by the fields each role is allowed to write.

         GUEST IDENTITY DOCUMENTS ARE SPLIT OUT. hotel_guests holds what
         reception needs to serve someone — name, phone, email, stay
         history. Passport numbers, visa details and uploaded ID scans go
         to hotel_guest_documents, which is owner-level, because section 9
         requires that sensitive guest documents are not exposed to
         unauthorised staff and a housekeeper has no reason to read a
         guest's passport. Splitting the collection is what enforces that:
         Firestore rules are per-document, so a single guest record with
         "sensitive fields" could not be half-readable.
      */
      /*
         One document per room per night, at a deterministic id, created
         inside the transaction that books the stay. This is what actually
         prevents a double booking: a client transaction cannot run a query,
         so it cannot re-check availability, but it CAN read these by id —
         and Firestore permits only one document per id, so two receptionists
         racing for the same night are two writes to the same path.

         Staff-level, because taking and releasing a hold is the front desk's
         job. Readable without signing in, because the booking engine in
         section 20 must show a public calendar of what is free; a lock
         carries only the booking reference and the guest's name for the
         desk's own display, never contact details or payment information.
      */
      match /hotel_room_nights/{docId} {
        allow get, list: if true;
        allow write: if isStaffOf(rid);
      }

      match /hotel_rooms/{docId}         { allow read, write: if isStaffOf(rid); }
      match /hotel_room_types/{docId}    { allow read, write: if isStaffOf(rid); }
      match /hotel_reservations/{docId}  { allow read, write: if isStaffOf(rid); }
      match /hotel_guests/{docId}        { allow read, write: if isStaffOf(rid); }
      match /hotel_guest_documents/{docId} { allow read, write: if isOwnerOf(rid); }
      match /hotel_folios/{docId}        { allow read, write: if isStaffOf(rid); }
      match /hotel_folio_items/{docId}   { allow read, write: if isStaffOf(rid); }
      match /hotel_payments/{docId}      { allow read, write: if isStaffOf(rid); }
      match /hotel_services/{docId}      { allow read, write: if isStaffOf(rid); }
      match /hotel_housekeeping/{docId}  { allow read, write: if isStaffOf(rid); }
      match /hotel_maintenance/{docId}   { allow read, write: if isStaffOf(rid); }
      match /hotel_lost_found/{docId}    { allow read, write: if isStaffOf(rid); }
      match /hotel_rate_plans/{docId}    { allow read, write: if isStaffOf(rid); }
      match /hotel_linen/{docId}         { allow read, write: if isStaffOf(rid); }
      match /hotel_minibar/{docId}       { allow read, write: if isStaffOf(rid); }
      match /hotel_banquets/{docId}      { allow read, write: if isStaffOf(rid); }
      match /hotel_cashier_shifts/{docId}{ allow read, write: if isStaffOf(rid); }

      // Owner-level only. Corporate rate contracts and agent commissions are
      // commercial terms, and a night audit is the property's closed books:
      // neither is a receptionist's to read, let alone rewrite.
      match /hotel_corporate/{docId}     { allow read, write: if isOwnerOf(rid); }
      match /hotel_channels/{docId}      { allow read, write: if isOwnerOf(rid); }

      // The two immutable hotel collections are NOT here. They cannot be:
      // see the note above the catch-all below.

      // Anything not named above is owner-only, NOT staff-level. A recursive
      // wildcard also matches private/, and Firestore grants access when ANY
      // matching rule allows it — so a staff-level catch-all here would hand
      // every cashier the owner's contact details. Every subcollection staff
      // actually use is listed explicitly above.
      //
      // THE SAME "ANY RULE WINS" BEHAVIOUR MAKES APPEND-ONLY IMPOSSIBLE HERE.
      // This wildcard grants the owner write on every path beneath the
      // restaurant, so a subcollection declaring `allow update: if false`
      // would still be editable: the grant here is enough on its own, and a
      // deny cannot cancel it. Night audits and hotel audit logs therefore
      // live in TOP-LEVEL collections keyed by restaurantId, alongside the
      // existing auditLogs and orders, which is the only place a rule that
      // denies everyone can actually hold. A rules test asserts it.
      match /{document=**} {
        allow read, write: if isOwnerOf(rid);
      }
    }

    /* ---------------- orders ---------------- */

    match /orders/{orderId} {
      // A customer creates their own order and then watches it on the
      // tracking page, neither of which involves signing in.
      allow get, list: if true;
      allow create: if true;

      // Updating an order is how a bill gets marked paid, items get
      // added and totals change. Staff only — this was wide open.
      allow update: if signedIn();
      allow delete: if signedIn();
    }

    /* ---------------- audit log ---------------- */

    /* ---------------- hotel: the records that close the books ----------------

       Top level, not under restaurants/{rid}, and deliberately so — the
       recursive catch-all there grants the owner write on everything
       beneath it, which would quietly make "append-only" a comment rather
       than a rule. Isolation is by the restaurantId on the document, which
       is how orders and auditLogs have always worked.
    */

    match /hotelNightAudits/{auditId} {
      // The record that a business day was closed and reconciled. Created
      // once by the property's owner; never altered afterwards, because a
      // closing that can be rewritten later is not a closing.
      allow get, list: if signedIn() && isStaffOf(resource.data.restaurantId);
      allow create: if isOwnerOf(request.resource.data.restaurantId);
      allow update, delete: if false;
    }

    match /hotelAuditLogs/{logId} {
      // Section 43. Staff generate the trail by doing their jobs; the owner
      // reads it; nobody edits it, super admin included.
      allow create: if signedIn() && isStaffOf(request.resource.data.restaurantId);
      allow get, list: if signedIn() && isOwnerOf(resource.data.restaurantId);
      allow update, delete: if false;
    }

    match /auditLogs/{logId} {
      // Append-only. The customer app writes login and order events.
      // Nothing may edit or erase history, including staff.
      allow create: if true;
      allow get, list: if signedIn();
      allow update, delete: if false;
    }

    /* ---------------- subscriptions and billing ---------------- */

    // Plans are shown on the public pricing page and the landing page.
    match /subscriptionPlans/{planId} {
      allow get, list: if true;
      allow write: if isSuperAdmin();
    }

    // Coupon and discount offers. Readable so a business can see what
    // is on sale; only a super admin may mint or change one.
    match /offers/{offerId} {
      allow get, list: if true;
      allow write: if isSuperAdmin();
    }

    // A business's own subscription record. Written by the backend with
    // the Admin SDK, which bypasses these rules entirely.
    match /subscriptions/{subId} {
      allow get, list: if signedIn();
      allow write: if isSuperAdmin();
    }

    /* ---------------- accounts ---------------- */

    // Membership of these collections is what grants super admin. If a
    // client could write here, anyone could promote themselves. Managed
    // through the Firebase console or the backend Admin SDK only.
    match /superAdmins/{docId} {
      allow get: if signedIn() && docId == uid();
      allow list, write: if false;
    }
    match /super_admins/{docId} {
      allow get: if signedIn() && docId == uid();
      allow list, write: if false;
    }
    match /admins/{docId} {
      allow get: if signedIn() && docId == uid();
      allow list, write: if false;
    }

    match /users/{docId} {
      allow get: if signedIn() && docId == uid();
      allow list: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    /* ---------------- support ---------------- */

    match /supportTickets/{ticketId} {
      allow create: if true;
      allow get, list, update, delete: if isSuperAdmin();
    }

    match /aiHelpChats/{chatId} {
      allow create: if true;
      allow get, list, update, delete: if isSuperAdmin();
    }

    /* ---------------- everything else ---------------- */

    // Default deny. A collection added later is closed until a rule
    // above is written for it, rather than open by accident.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
